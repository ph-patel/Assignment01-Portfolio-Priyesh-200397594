	Description: code defines the contactme page of website
	Reference: Bootstrap form page : https://getbootstrap.com/docs/4.3/components/forms/

extends layout

block content
	.main.container.center_div
		.row
			.col-md-6.col-md-offset-3
			h1.display-4.m-b-2 Contact Me       
				form(method='POST' action='/register')
					div.form-group
						label(for='name') Name:
						input#name.form-control(type='text', placeholder='first and last' name='name')
					div.form-group
						label(for='email') Email:
						input#email.form-control(type='email', placeholder='name@email.com' name='email')
					div.form-group
						label(for='subject') Subject:
						input#subject.form-control(type='text', placeholder='Why you want to contact me ?' name='subject')
					button.btn.btn-primary(type='submit') Submit
